{
  "name": "telegram-challenge-bot",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "observability": {"enabled": true},
  "triggers": {"crons": ["* * * * *"]},
  "durable_objects": {"bindings": [{"name": "CHALLENGE", "class_name": "ChallengeBot"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ChallengeBot"]}]
}
